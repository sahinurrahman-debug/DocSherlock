# Copy to backend/.env and fill in. Everything has a working default except the LLM key.
# Never commit .env - it is git-ignored.

# ---- LLM: Groq is the main answering engine; the rule-based engine is the automatic fallback -------------
GROQ_API_KEY=                       # create one at https://console.groq.com/keys
GROQ_MODEL=openai/gpt-oss-120b      # strict JSON-schema output + reasoning. Cheaper/faster: openai/gpt-oss-20b
GROQ_FALLBACK_MODEL=llama-3.3-70b-versatile
GROQ_REASONING_EFFORT=low           # low | medium | high  (gpt-oss models)

# ---- Database: PostgreSQL in production. Empty = SQLite file in backend/data (zero-setup development) ----------
DATABASE_URL=
# e.g. postgresql+psycopg://docsherlock:docsherlock@localhost:5432/docsherlock   (postgres:// URLs from Render also work)

# ---- Vector store: Qdrant server / Qdrant Cloud. Empty = embedded local Qdrant in backend/data/qdrant -----------
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=docsherlock_chunks

# ---- Free-tier / 512 MB hosts: one switch. Disables embeddings + reranker (keyword retrieval only), shrinks OCR and
# ---- ingestion to one worker. Measured peak ~360 MB with scanned documents. Qdrant is not loaded at all in this mode.
LOW_MEMORY=false

# ---- Hosted embeddings (no local model, no extra RAM): semantic search on a 512 MB host together with LOW_MEMORY=true + Qdrant Cloud ----
# EMBEDDING_API_URL=https://api.jina.ai/v1/embeddings      # any OpenAI-style /embeddings endpoint
# EMBEDDING_API_KEY=                                       # https://jina.ai/embeddings (free key, non-commercial)
# EMBEDDING_MODEL=jina-embeddings-v3
# EMBEDDING_DIM=512                                        # also sent as "dimensions"; EMBEDDING_API_DIMENSIONS=false for providers that reject it

# ---- Retrieval models (FastEmbed, local CPU). Set DENSE_ENABLED=false on very small instances (<1 GB RAM) -------
DENSE_ENABLED=true
RERANK_ENABLED=true

# ---- Misc ------------------------------------------------------------------------------------------------
MAX_UPLOAD_MB=40
RETENTION_DAYS=0                    # >0: delete documents older than N days at start-up (use ~14 on Neon's free 0.5 GB)
OCR_ENABLED=true
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO
